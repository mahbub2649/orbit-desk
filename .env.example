# Copy this file to .env and fill in what you have. Everything is optional:
# the app runs with no keys at all. KEYS.md explains where each one comes from.

# --- AI: reads free-text customer requests ---------------------------------
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5   # cheaper and faster; default claude-opus-5-5

# --- Integrations: real when filled in, simulated when empty --------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SLACK_WEBHOOK_URL=

# --- Extra data sources (not wired yet) ------------------------------------
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=

# --- App settings -----------------------------------------------------------
# INTEL_ENABLED=false     # turn off all public data feeds and run fully offline
# PORT=8000
